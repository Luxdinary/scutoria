# Beispiel für site/.env (lokal) und für die Umgebungsvariablen bei Render. Keine echten Schlüssel hier eintragen;
# .env ist durch .gitignore ausgeschlossen. Bedeutung jeder Variable: README.md, Abschnitt Umgebung. Prüfen: npm run preflight

# Betrieb
PORT=8080
SITE_MODE=preview
BASE_URL=https://scutoria.com
LEGAL_REVIEWED_AT=
DATA_DIR=./data
APP_VERSION=dev

# Vorschauzugang live (Adressen, die den Generator ohne Kauf benutzen dürfen), durch Komma getrennt
PREVIEW_ACCESS_EMAILS=

# Stripe (eingeschränkter Schlüssel; Testmodus rk_test_..., Livemodus rk_live_...; Webhook-Geheimnis whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=true
STRIPE_TAX_BEHAVIOR=inclusive

# Preise in Cent (E10, E14, E21); je Toolkit überschreibbar
PRICE_YEAR_CENTS=19900
PRICE_PILOT_CENTS=9900
PILOT_SEATS=10
# PRICE_SECURITY_YEAR_CENTS=19900
# PRICE_SECURITY_PILOT_CENTS=9900
# PILOT_SEATS_SECURITY=10

# Brevo (Transaktionsmails; Absender muss in Brevo verifiziert sein)
BREVO_API_KEY=
MAIL_FROM=kontakt@scutoria.com
MAIL_FROM_NAME=Scutoria

# Memo-Generatoren (E11): PDF nur per E-Mail; Nummer der Brevo-Liste „Memo-Kontakte“
MEMO_PDF_PUBLIC=false
BREVO_MEMO_LIST_ID=

# PDF-Druck am Laptop: msedge (Standard auf Windows), chrome, oder leer für Playwright-Chromium
# PDF_CHANNEL=msedge
